# Codex execution policy for this exercise. Other branches hold reference
# solutions; only the candidate fetches them, when the interviewer says so.

prefix_rule(
    pattern = ["git"],
    decision = "forbidden",
    justification = "git is off limits for the assistant here; the person runs git themselves",
)

prefix_rule(
    pattern = ["uv", "run", "reveal"],
    decision = "forbidden",
    justification = "only the person fetches the reference solution",
)
